# Copy to .env.local for local development. Never commit real values.
# Setup guide: docs/portal-setup.md

# Auth.js: random secret that encrypts session cookies (openssl rand -base64 33)
AUTH_SECRET=

# Google sign-in client (Google Cloud → APIs & Services → Clients)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Portal data: Apps Script web app URL (ends in /exec) and its secret key
PORTAL_SCRIPT_URL=
PORTAL_SCRIPT_KEY=

# Optional: enables "Draft coffee chat" in the alumni directory
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
